{
  "expo": {
    "name": "Farmhands",
    "slug": "farmhands",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F1E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": false
    },
    "android": {
      "package": "com.farmhands.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d2b676d7-d01c-4312-a612-26e50c6c530f"
      }
    },
    "owner": "charan211"
  }
}
